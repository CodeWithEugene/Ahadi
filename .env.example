# Copy to .env (git-ignored). Testnet only; never put mainnet keys here.

# LLM provider for the Omega agent: Anthropic | ASIOne | ASICloud | OpenRouter
OMEGA_PROVIDER=OpenRouter
OMEGA_MODEL=moonshotai/kimi-k3
ANTHROPIC_API_KEY=
ASIONE_API_KEY=
ASI_API_KEY=
OPENROUTER_API_KEY=

# Bridge <-> Omega shared secrets (any random strings)
WS_TOKEN=
AHADI_TOOL_SECRET=

# Organiser console write actions require this passcode (leave empty for local development)
AHADI_CONSOLE_PASSCODE=

# Optional: relay a Telegram bot into the same agent
TELEGRAM_BOT_TOKEN=
